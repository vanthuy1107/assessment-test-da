# ============================================================
# Internal-only files — DO NOT share with candidates
# ============================================================
# Includes: internal README, rubric, reference-findings,
# extract.sql, anonymize.py, mapping.csv, expected_status.csv,
# and all raw data with real names.
_internal/
**/_internal/

# Safety net: block raw/ even if it is copied outside _internal/
**/raw/
*_raw.csv

# ============================================================
# Candidate submissions (if submissions are stored locally)
# ============================================================
submissions/
*.submission.*

# ============================================================
# OS / editor
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/
*.iml

# ============================================================
# Python (candidates may use pandas/jupyter)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.venv/
venv/
env/
.env
.python-version

# ============================================================
# Data outputs (derived files, not part of the original test)
# ============================================================
*.parquet
*.pkl
*.feather

# ============================================================
# Excel / office temp
# ============================================================
~$*.xlsx
~$*.xlsm
~$*.docx

